<mxfile host="app.diagrams.net" modified="2026-08-31T22:03:47+00:00" agent="HLRMS diagram generator" version="24.7.17" type="device" compressed="false"><diagram id="15-fault-tolerance-fault-tolerance-recovery" name="Page-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-eyebrow" value="HLRMS · RELIABILITY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="70" y="18" width="900" height="36" as="geometry" /></mxCell><mxCell id="diagram-title" value="Fault Tolerance and Recovery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=35;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="1500" height="46" as="geometry" /></mxCell><mxCell id="diagram-subtitle" value="Different failures produce different availability behavior, but accepted work remains traceable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="1700" height="34" as="geometry" /></mxCell><mxCell id="diagram-rule" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="139" as="sourcePoint" /><mxPoint x="1850" y="139" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ft-rabbit" value="&lt;b&gt;RabbitMQ Unavailable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Request API remains available&lt;br&gt;Outbox accumulates in PostgreSQL&lt;br&gt;Publisher reconnects and drains later&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="395" height="300" as="geometry" /></mxCell><mxCell id="ft-redis" value="&lt;b&gt;Redis Unavailable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Request Service remains ready&lt;br&gt;DB-backed idempotency fallback&lt;br&gt;Cache performance is degraded&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontFamily=DejaVu Sans;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="515" y="230" width="395" height="300" as="geometry" /></mxCell><mxCell id="ft-worker" value="&lt;b&gt;Worker Failure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Message remains unacknowledged/redelivered&lt;br&gt;Listener retries&lt;br&gt;Terminal failure routes to DLQ&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontFamily=DejaVu Sans;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="970" y="230" width="395" height="300" as="geometry" /></mxCell><mxCell id="ft-pg" value="&lt;b&gt;PostgreSQL Unavailable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Admission is temporarily unavailable&lt;br&gt;Readiness fails&lt;br&gt;Services recover after DB restart&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#881337;fontFamily=DejaVu Sans;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1425" y="230" width="395" height="300" as="geometry" /></mxCell><mxCell id="ft-detect" value="&lt;b&gt;1 · Detect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Health probes · errors · metrics&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontColor=#155E75;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="85" y="680" width="330" height="125" as="geometry" /></mxCell><mxCell id="ft-isolate" value="&lt;b&gt;2 · Isolate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Outbox · queue · circuit breaker · readiness&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#2563EB;fontColor=#123B7A;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="680" width="330" height="125" as="geometry" /></mxCell><mxCell id="ft-recover" value="&lt;b&gt;3 · Recover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Restart/reconnect · retry · redispatch&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="995" y="680" width="330" height="125" as="geometry" /></mxCell><mxCell id="ft-reconcile" value="&lt;b&gt;4 · Reconcile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Outbox=0 · Queue=0 · DLQ delta · row counts&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1450" y="680" width="330" height="125" as="geometry" /></mxCell><mxCell id="ft-workflow" value="&lt;b&gt;Every injected failure is evaluated through the same recovery workflow&lt;/b&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontColor=#155E75;fontFamily=DejaVu Sans;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="570" width="840" height="60" as="geometry" /></mxCell><mxCell id="ft-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="ft-detect" target="ft-isolate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ft-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="ft-isolate" target="ft-recover"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ft-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="ft-recover" target="ft-reconcile"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ft-rule" value="Reliability claim: every request that was durably accepted can be reconciled after recovery; availability during the outage depends on the failed dependency." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=18;fontStyle=1;fontColor=#0F172A;whiteSpac