<mxfile host="app.diagrams.net" modified="2026-08-31T22:03:31+00:00" agent="HLRMS diagram generator" version="24.7.17" type="device" compressed="false"><diagram id="06-state-request-lifecycle-state" name="Page-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-eyebrow" value="HLRMS · STATE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="70" y="18" width="900" height="36" as="geometry" /></mxCell><mxCell id="diagram-title" value="Request Lifecycle State Machine" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=35;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="1500" height="46" as="geometry" /></mxCell><mxCell id="diagram-subtitle" value="Only four persisted request states exist in the implemented core domain." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="1700" height="34" as="geometry" /></mxCell><mxCell id="diagram-rule" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="139" as="sourcePoint" /><mxPoint x="1850" y="139" as="targetPoint" /></mxGeometry></mxCell><mxCell id="st-start" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#475569&quot;&gt;Valid new request&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#1E293B;fontFamily=DejaVu Sans;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="95" y="440" width="160" height="90" as="geometry" /></mxCell><mxCell id="st-pending" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Request and Outbox event committed. Publishing may retry without changing this state.&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#2563EB;fontColor=#123B7A;fontFamily=DejaVu Sans;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="310" height="170" as="geometry" /></mxCell><mxCell id="st-processing" value="&lt;b&gt;PROCESSING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;A Worker owns the event and starts idempotent processing.&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="845" y="390" width="310" height="170" as="geometry" /></mxCell><mxCell id="st-completed" value="&lt;b&gt;COMPLETED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Processing result persisted. Terminal success state.&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontFamily=DejaVu Sans;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1310" y="245" width="360" height="165" as="geometry" /></mxCell><mxCell id="st-failed" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Error persisted after rejection or retry exhaustion. Terminal failure state.&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#881337;fontFamily=DejaVu Sans;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1310" y="615" width="360" height="165" as="geometry" /></mxCell><mxCell id="st-end-ok" value="&lt;b&gt;End&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#475569&quot;&gt;Success&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontFamily=DejaVu Sans;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1740" y="280" width="120" height="90" as="geometry" /></mxCell><mxCell id="st-end-fail" value="&lt;b&gt;End&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#475569&quot;&gt;Failure&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#881337;fontFamily=DejaVu Sans;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1740" y="650" width="120" height="90" as="geometry" /></mxCell><mxCell id="st-1" value="transaction committed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="st-start" target="st-pending"><mxGeometry relative="1" as="geometry"><mxPoint x="-41.25" y="-13.0" as="offset" /></mxGeometry></mxCell><mxCell id="st-2" value="event consumed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="st-pending" 