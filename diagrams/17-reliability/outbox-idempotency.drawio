<mxfile host="app.diagrams.net" modified="2026-08-31T22:03:50+00:00" agent="HLRMS diagram generator" version="24.7.17" type="device" compressed="false"><diagram id="17-reliability-outbox-idempotency" name="Page-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-eyebrow" value="HLRMS · RELIABILITY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="70" y="18" width="900" height="36" as="geometry" /></mxCell><mxCell id="diagram-title" value="Outbox and End-to-End Idempotency" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=35;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="1500" height="46" as="geometry" /></mxCell><mxCell id="diagram-subtitle" value="Producer-side atomicity and consumer-side deduplication close different failure gaps." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="1700" height="34" as="geometry" /></mxCell><mxCell id="diagram-rule" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="139" as="sourcePoint" /><mxPoint x="1850" y="139" as="targetPoint" /></mxGeometry></mxCell><mxCell id="group-oi-producer" value="&lt;b&gt;PRODUCER SIDE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#475569&quot;&gt;Request Service + Outbox Publisher&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F0FE;fillOpacity=38;strokeColor=#2563EB;fontColor=#123B7A;fontFamily=DejaVu Sans;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="850" height="570" as="geometry" /></mxCell><mxCell id="group-oi-consumer" value="&lt;b&gt;CONSUMER SIDE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#475569&quot;&gt;RabbitMQ + Request Worker&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECFDF5;fillOpacity=38;strokeColor=#059669;fontColor=#065F46;fontFamily=DejaVu Sans;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="850" height="570" as="geometry" /></mxCell><mxCell id="oi-client" value="&lt;b&gt;1 · Client Command&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;User-scoped Idempotency-Key + payload&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="105" y="285" width="300" height="115" as="geometry" /></mxCell><mxCell id="oi-lock" value="&lt;b&gt;2 · Distributed Coordination&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Redis lock / replay cache with DB fallback&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontFamily=DejaVu Sans;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="515" y="285" width="300" height="115" as="geometry" /></mxCell><mxCell id="oi-tx" value="&lt;b&gt;3 · Single DB Transaction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;INSERT request&lt;br&gt;INSERT outbox event&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="105" y="520" width="300" height="150" as="geometry" /></mxCell><mxCell id="oi-pub" value="&lt;b&gt;4 · Outbox Publisher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Claim · publish · confirm · mark PUBLISHED&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="515" y="520" width="300" height="150" as="geometry" /></mxCell><mxCell id="oi-rabbit" value="&lt;b&gt;5 · At-Least-Once Delivery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;RabbitMQ may redeliver after failures&lt;/font&gt;" style="shape=mxgraph.basic.rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1075" y="285" width="300" height="115" as="geometry" /></mxCell><mxCell id="oi-register" value="&lt;b&gt;6 · Register event_id&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;INSERT ... ON CONFLICT DO NOTHING&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1485" y="285" width="300" height="115" as="geometry" /></mxCell><mxCell id="oi-work" value="&lt;b&gt;7 · Process Once&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Only a newly registered event runs business processing&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1075" y="520" width="300" height="150" as="geometry" /></mxCell><mxCell id="oi-final" value="&lt;b&gt;8 · Commit Outcome&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Final request state + processed_at + ACK&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1485" y="520" width="300" height="150" as="geometry" /></mxCell><mxCell id="oi-result" value="&lt;b&gt;End-to-End Guarantee&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;A request is never lost between PostgreSQL and RabbitMQ, and a redelivered event does not repeat its business effect.&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontFamily=DejaVu Sans;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="800" width="1420" height="95" as="geometry" /></mxCell><mxCell id="oi-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="oi-client" target="oi-lock"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="oi-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamil