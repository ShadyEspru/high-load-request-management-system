tColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="oi-work" target="oi-final"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="oi-producer-rule" value="Replay: same payload → original Request ID; different payload → 409" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="160" y="440" width="590" height="45" as="geometry" /></mxCell><mxCell id="oi-consumer-rule" value="Duplicate event_id → skip the business effect and ACK" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1130" y="440" width="590" height="45" as="geometry" /></mxCell><mxCell id="legend-box-0" value="" style="rounded=1;arcSize=25;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="1018" width="18" height="18" as="geometry" /></mxCell><mxCell id="legend-label-0" value="Client idempotency" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="95" y="1012" width="151.20000000000002" height="30" as="geometry" /></mxCell><mxCell id="legend-box-1" value="" style="rounded=1;arcSize=25;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="259.6" y="1018" width="18" height="18" as="geometry" /></mxCell><mxCell id="legend-label-1" value="Transactional guarantee" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="284.6" y="1012" width="193.20000000000002" height="30" as="geometry" /></mxCell><mxCell id=