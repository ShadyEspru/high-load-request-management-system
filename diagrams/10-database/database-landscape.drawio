<mxfile host="app.diagrams.net" modified="2026-08-31T22:03:40+00:00" agent="HLRMS diagram generator" version="24.7.17" type="device" compressed="false"><diagram id="10-database-database-landscape" name="Page-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-eyebrow" value="HLRMS · DATA MODEL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="70" y="18" width="900" height="36" as="geometry" /></mxCell><mxCell id="diagram-title" value="Database Landscape and Ownership" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=35;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="1500" height="46" as="geometry" /></mxCell><mxCell id="diagram-subtitle" value="HLRMS owns authentication and request reliability data; client-domain data remains outside the core platform." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="1700" height="34" as="geometry" /></mxCell><mxCell id="diagram-rule" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="139" as="sourcePoint" /><mxPoint x="1850" y="139" as="targetPoint" /></mxGeometry></mxCell><mxCell id="group-dbl-core" value="&lt;b&gt;HLRMS-OWNED DATA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#475569&quot;&gt;PostgreSQL 17 · Flyway migrations&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F0FE;fillOpac