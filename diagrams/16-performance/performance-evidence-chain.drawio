<mxfile host="app.diagrams.net" modified="2026-08-31T22:03:49+00:00" agent="HLRMS diagram generator" version="24.7.17" type="device" compressed="false"><diagram id="16-performance-performance-evidence-chain" name="Page-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-eyebrow" value="HLRMS · PERFORMANCE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="70" y="18" width="900" height="36" as="geometry" /></mxCell><mxCell id="diagram-title" value="Performance Evidence Chain" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=35;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="1500" height="46" as="geometry" /></mxCell><mxCell id="diagram-subtitle" value="A random run identifier chosen at test time links every visible and persisted artifact." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="1700" height="34" as="geometry" /></mxCell><mxCell id="diagram-rule" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="139" as="sourcePoint" /><mxPoint x="1850" y="139" as="targetPoint" /></mxGeometry></mxCell><mxCell id="pe-run-id" value="&lt;b&gt;One TEST_RUN_ID propagates through every artifact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Chosen at test time; printed by k6 and embedded in requests, queries and screenshots.&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#2563EB;fontColor=#123B7A;fontFamily=DejaVu Sans;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="185" width="1220" height="75" as="geometry" /></mxCell><mxCell id="pe-id" value="&lt;b&gt;1 · Generate Run ID&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;DEFENSE-&amp;lt;UTC&amp;gt;-&amp;lt;random&amp;gt;&lt;br&gt;Shown before the run&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="260" height="300" as="geometry" /></mxCell><mxCell id="pe-k6" value="&lt;b&gt;2 · k6 Executes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Target / effective RPS&lt;br&gt;iterations · drops · latency · failures&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="355" y="330" width="260" height="300" as="geometry" /></mxCell><mxCell id="pe-live" value="&lt;b&gt;3 · Grafana Live&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Gateway RPS&lt;br&gt;queue depth&lt;br&gt;worker completion&lt;br&gt;resource saturation&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontColor=#155E75;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="260" height="300" as="geometry" /></mxCell><mxCell id="pe-db" value="&lt;b&gt;4 · Database Reconcile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;requests&lt;br&gt;outbox_events&lt;br&gt;processed_events&lt;br&gt;unique IDs&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="965" y="330" width="260" height="300" as="geometry" /></mxCell><mxCell id="pe-broker" value="&lt;b&gt;5 · Pipeline Drain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Outbox pending = 0&lt;br&gt;ready = 0&lt;br&gt;unacked = 0&lt;br&gt;DLQ unchanged&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1270" y="330" width="260" height="300" as="geometry" /></mxCell><mxCell id="pe-record" value="&lt;b&gt;6 · Final Record&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;color:#475569&quot;&gt;Script commit&lt;br&gt;command&lt;br&gt;hardware&lt;br&gt;summary + screenshots&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1575" y="330" width="260" height="300" as="geometry" /></mxCell><mxCell id="pe-proof" value="&lt;b&gt;Verification Rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:19px;color:#475569&quot;&gt;Accepted business requests = persisted requests = Outbox events = published events = processed events&lt;br&gt;with zero permanent backlog and no unexpected DLQ growth.&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#2563EB;fontColor=#123B7A;fontFamily=DejaVu Sans;fontSi