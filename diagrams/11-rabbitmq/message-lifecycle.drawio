<mxfile host="app.diagrams.net" modified="2026-08-31T22:03:43+00:00" agent="HLRMS diagram generator" version="24.7.17" type="device" compressed="false"><diagram id="11-rabbitmq-message-lifecycle" name="Page-1"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram-eyebrow" value="HLRMS · MESSAGING" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="70" y="18" width="900" height="36" as="geometry" /></mxCell><mxCell id="diagram-title" value="Reliable Message Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=35;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="1500" height="46" as="geometry" /></mxCell><mxCell id="diagram-subtitle" value="Every accepted request progresses through durable producer and consumer checkpoints." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="1700" height="34" as="geometry" /></mxCell><mxCell id="diagram-rule" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="139" as="sourcePoint" /><mxPoint x="1850" y="139" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ml-1" value="&lt;b&gt;1 · Commit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Request + Outbox in one DB transaction&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="205" height="190" as="geometry" /></mxCell><mxCell id="ml-2" value="&lt;b&gt;2 · Claim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Publisher atomically claims a pending batch&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="335" width="205" height="190" as="geometry" /></mxCell><mxCell id="ml-3" value="&lt;b&gt;3 · Publish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Direct exchange + publisher confirm&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="600" y="335" width="205" height="190" as="geometry" /></mxCell><mxCell id="ml-4" value="&lt;b&gt;4 · Buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Durable processing queue absorbs spikes&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="870" y="335" width="205" height="190" as="geometry" /></mxCell><mxCell id="ml-5" value="&lt;b&gt;5 · Register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Consumer inserts event_id if absent&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="335" width="205" height="190" as="geometry" /></mxCell><mxCell id="ml-6" value="&lt;b&gt;6 · Execute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;Worker updates PROCESSING then executes&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1410" y="335" width="205" height="190" as="geometry" /></mxCell><mxCell id="ml-7" value="&lt;b&gt;7 · Finalize&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;color:#475569&quot;&gt;COMPLETED / FAILED + ACK&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1680" y="335" width="205" height="190" as="geometry" /></mxCell><mxCell id="ml-retry" value="&lt;b&gt;Transient Publish Failure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Outbox remains retryable; claim is released or retried&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="310" height="130" as="geometry" /></mxCell><mxCell id="ml-redeliver" value="&lt;b&gt;Consumer Failure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Listener retry with exponential backoff&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="690" width="310" height="130" as="geometry" /></mxCell><mxCell id="ml-dlq" value="&lt;b&gt;Retry Exhausted&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#475569&quot;&gt;Request marked FAILED and message routed to DLQ&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#881337;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="690" width="310" height="130" as="geometry" /></mxCell><mxCell id="ml-e-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="ml-1" target="ml-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ml-e-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="ml-2" target="ml-3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ml-e-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFamily=DejaVu Sans;fontSize=13;fontColor=#475569;fontStyle=0;labelBackgroundColor=none;labelBorderColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="ml-3" target="ml-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ml-e-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2.2;fontFam