        <mxCell id="title2" value="مخطط سياق نظام إدارة الطلبات عالية الحمل" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=Noto Sans Arabic;direction=rtl;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="800" height="45" as="geometry"/></mxCell>
        <mxCell id="system" value="&lt;b&gt;HLRMS&lt;/b&gt;&lt;br&gt;&lt;b&gt;نظام إدارة الطلبات عالية الحمل&lt;/b&gt;&lt;br&gt;&lt;br&gt;منصة عامة تستقبل الطلبات من الأنظمة العميلة، وتدير معالجتها غير المتزامنة، وتوفر حالة كل طلب ونتيجته ومعلومات تتبعه.&lt;br&gt;&lt;br&gt;Accepts requests, manages asynchronous processing, and exposes request status, tracking, and results." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=4;fontSize=20;fontFamily=Noto Sans Arabic;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="680" height="385" as="geometry"/></mxCell>
        <mxCell id="client" value="&lt;b&gt;الأنظمة العميلة&lt;/b&gt;&lt;br&gt;&lt;br&gt;Android Demo Application&lt;br&gt;Web / External Client System&lt;br&gt;&lt;br&gt;ترسل الطلبات وتستعلم عن حالتها" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontSize=18;fontFamily=Noto Sans Arabic;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="265" width="360" height="220" as="geometry"/></mxCell>
        <mxCell id="admin" value="&lt;b&gt;مسؤول النظام ومشغله&lt;/b&gt;&lt;br&gt;System Administrator / Operator&lt;br&gt;&lt;br&gt;يراقب التشغيل ويتابع الطلبات المتعثرة" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=3;fontSize=18;fontFamily=Noto Sans Arabic;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="835" width="480" height="195" as="geometry"/></mxCell>
        <mxCell id="external" value="&lt;b&gt;خدمات خارجية اختيارية&lt;/b&gt;&lt;br&gt;&lt;br&gt;Email / SMS / Storage&lt;br&gt;Third-party APIs&lt;br&gt;&lt;br&gt;تستدعى عند تنفيذ أنواع طلبات محددة" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;fontSize=18;fontFamily=Noto Sans Arabic;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="245" width="360" height="255" as="geometry"/></mxCell>
        <mxCell id="monitor" value="&lt;b&gt;منصة المراقبة&lt;/b&gt;&lt;br&gt;Prometheus / Grafana&lt;br&gt;&lt;br&gt;تجمع المقاييس وتعرض لوحات التشغيل" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=3;fontSize=18;fontFamily=Noto Sans Arabic;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="750" width="360" height="200" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;ملاحظة&lt;/b&gt;&lt;br&gt;لا يعرض هذا المخطط التفاصيل الداخلية للنظام، وستظهر في المخططات اللاحقة." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontSize=16;fontFamily=Noto Sans Arabic;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="360" height="130" as="geometry"/></mxCell>
