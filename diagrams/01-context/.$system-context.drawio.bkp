        <mxCell id="e2" value="معرف - حالة - نتيجة" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#166534;strokeWidth=3;fontSize=16;fontFamily=Noto Sans Arabic;" edge="1" parent="1" source="system" target="client"><mxGeometry relative="1" as="geometry"/></mxCell>
