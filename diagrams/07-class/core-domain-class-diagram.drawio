<mxfile host="app.diagrams.net" modified="2026-07-23T00:00:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="coreDomainClass" name="Core Domain Class Diagram"><mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="مخطط الأصناف للنموذج الأساسي&lt;br&gt;&lt;font style='font-size:16px;font-weight:normal;color:#667085'&gt;Core Domain Class Diagram - HLRMS&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Noto Sans Arabic;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1100" height="70" as="geometry"/></mxCell><mxCell id="history" value="&lt;div style=&#x27;text-align:center&#x27;&gt;&lt;b style=&#x27;font-size:18px&#x27;&gt;RequestStatusHistory&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Noto Sans Arabic;font-size:14px&#x27;&gt;سجل تغيّر حالة الطلب&lt;/span&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ id: UUID&lt;br&gt;+ requestId: UUID&lt;br&gt;+ previousStatus: RequestStatus?&lt;br&gt;+ newStatus: RequestStatus&lt;br&gt;+ reason: String?&lt;br&gt;+ changedBy: String&lt;br&gt;+ changedAt: Instant&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ recordsTransition(): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F3F7FF;strokeColor=#4267A9;strokeWidth=2;fontColor=#243247;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="420" height="300" as="geometry"/></mxCell><mxCell id="request" value="&lt;div style=&#x27;text-align:center&#x27;&gt;&lt;b style=&#x27;font-size:18px&#x27;&gt;Request&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Noto Sans Arabic;font-size:14px&#x27;&gt;الطلب&lt;/span&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ id: UUID&lt;br&gt;+ clientId: String&lt;br&gt;+ requestType: String&lt;br&gt;+ priority: RequestPriority&lt;br&gt;+ payload: JSON&lt;br&gt;+ status: RequestStatus&lt;br&gt;+ retryCount: int&lt;br&gt;+ createdAt: Instant&lt;br&gt;+ updatedAt: Instant&lt;br&gt;+ queuedAt: Instant?&lt;br&gt;+ completedAt: Instant?&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ changeStatus(status, reason): void&lt;br&gt;+ incrementRetryCount(): void&lt;br&gt;+ canBeRetried(policy): boolean&lt;br&gt;+ markCompleted(): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#EEF8F2;strokeColor=#39825A;strokeWidth=2;fontColor=#243247;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="135" width="460" height="480" as="geometry"/></mxCell><mxCell id="attempt" value="&lt;div style=&#x27;text-align:center&#x27;&gt;&lt;b style=&#x27;font-size:18px&#x27;&gt;ProcessingAttempt&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Noto Sans Arabic;font-size:14px&#x27;&gt;محاولة معالجة الطلب&lt;/span&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ id: UUID&lt;br&gt;+ requestId: UUID&lt;br&gt;+ attemptNumber: int&lt;br&gt;+ workerId: String&lt;br&gt;+ status: AttemptStatus&lt;br&gt;+ startedAt: Instant&lt;br&gt;+ finishedAt: Instant?&lt;br&gt;+ failureType: FailureType?&lt;br&gt;+ errorMessage: String?&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ start(): void&lt;br&gt;+ succeed(): void&lt;br&gt;+ fail(type, message): void&lt;br&gt;+ duration(): Duration&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF8E8;strokeColor=#B67A20;strokeWidth=2;fontColor=#243247;shadow=1;" vertex="1" parent="1"><mxGeometry x="1210" y="180" width="420" height="350" as="geometry"/></mxCell><mxCell id="policy" value="&lt;div style=&#x27;text-align:center&#x27;&gt;&lt;b style=&#x27;font-size:18px&#x27;&gt;RetryPolicy&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Noto Sans Arabic;font-size:14px&#x27;&gt;إعدادات إعادة المحاولة&lt;/span&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ id: UUID&lt;br&gt;+ name: String&lt;br&gt;+ maxAttempts: int&lt;br&gt;+ initialDelayMs: long&lt;br&gt;+ multiplier: double&lt;br&gt;+ maxDelayMs: long&lt;br&gt;+ strategy: BackoffStrategy&lt;br&gt;+ retryableFailureTypes: Set&amp;lt;FailureType&amp;gt;&lt;br&gt;+ enabled: boolean&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ isRetryAllowed(attempt, type): boolean&lt;br&gt;+ calculateDelay(attempt): Duration&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F8F2FF;strokeColor=#7952A6;strokeWidth=2;fontColor=#243247;shadow=1;" vertex="1" parent="1"><mxGeometry x="100" y="730" width="450" height="340" as="geometry"/></mxCell><mxCell id="result" value="&lt;div style=&#x27;text-align:center&#x27;&gt;&lt;b style=&#x27;font-size:18px&#x27;&gt;ProcessingResult&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Noto Sans Arabic;font-size:14px&#x27;&gt;نتيجة المعالجة&lt;/span&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ id: UUID&lt;br&gt;+ attemptId: UUID&lt;br&gt;+ success: boolean&lt;br&gt;+ resultData: JSON?&lt;br&gt;+ resultCode: String?&lt;br&gt;+ message: String?&lt;br&gt;+ createdAt: Instant&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.55&#x27;&gt;+ successful(data): ProcessingResult&lt;br&gt;+ failed(code, message): ProcessingResult&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#EFF8FF;strokeColor=#347DA5;strokeWidth=2;fontColor=#243247;shadow=1;" vertex="1" parent="1"><mxGeometry x="1165" y="730" width="465" height="310" as="geometry"/></mxCell><mxCell id="requestStatus" value="&lt;div style=&#x27;text-align:center;font-family:DejaVu Sans Mono&#x27;&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;«enumeration»&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;font-size:16px&#x27;&gt;RequestStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.4&#x27;&gt;RECEIVED&lt;br&gt;VALIDATING&lt;br&gt;ACCEPTED&lt;br&gt;REJECTED&lt;br&gt;QUEUED&lt;br&gt;PROCESSING&lt;br&gt;SUCCEEDED&lt;br&gt;FAILED&lt;br&gt;RETRY_SCHEDULED&lt;br&gt;DEAD_LETTERED&lt;br&gt;CANCELLED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F4F5F7;strokeColor=#657080;strokeWidth=1.8;fontColor=#243247;shadow=1;" vertex="1" parent="1"><mxGeometry x="610" y="760" width="250" height="300" as="geometry"/></mxCell><mxCell id="attemptStatus" value="&lt;div style=&#x27;text-align:center;font-family:DejaVu Sans Mono&#x27;&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;«enumeration»&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;font-size:16px&#x27;&gt;AttemptStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&#x27;text-align:left;font-family:DejaVu Sans Mono;font-size:13px;line-height:1.4&#x27;&gt;STARTED&lt;br&gt;SUCCEEDED&lt;br&gt;FAILED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F4F5F7;strokeColor=#657080;strokeWidth=1.8;fontColor=#243247;shadow=1;" vertex="1" parent="1"><mxGeometry x="885" y="760" width="235" height="210" as="geometry"/></mxCell><mxCell id="backoff" value="&